# Copy to `.env.local` and adjust if your game server host/port differs.
# In development, omit this so the app builds ws://<page-host>:3001 from the browser (needed for LAN devices).
# Set explicitly when the WS server is not reachable at that URL (e.g. separate machine).
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Portfolio / deploy. Unset optional keys to hide those footer rows in the UI.
# Uncomment and set real URLs for production demos:
# NEXT_PUBLIC_REPO_URL=https://github.com/your-org/skribbl

# Optional showcase / documentation links (footer only; distinct from Create room / Join actions).
# NEXT_PUBLIC_DEMO_URL=https://example.com/demo
# NEXT_PUBLIC_DOCS_URL=https://example.com/docs
